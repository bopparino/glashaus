{
  "name": "glashaus",
  "version": "3.0.0-alpha.2",
  "description": "An Ollama companion with persistent identity, source-backed character setup, inspectable memory, and a shared web and Telegram conversation.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bopparino/glashaus.git"
  },
  "homepage": "https://github.com/bopparino/glashaus#readme",
  "bugs": {
    "url": "https://github.com/bopparino/glashaus/issues"
  },
  "keywords": [
    "ai-companion",
    "companion",
    "ollama",
    "local-first",
    "sqlite",
    "memory",
    "telegram-bot",
    "character",
    "roleplay",
    "self-hosted"
  ],
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "bin": {
    "glashaus": "bin/glashaus-v3.js"
  },
  "files": [
    "bin/glashaus-v3.js",
    "dist/",
    "README.md",
    "RELEASE.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node --watch app/server/main.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && vite build --configLoader native",
    "start": "node bin/glashaus-v3.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node tests/browser.e2e.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
